# Copy to .env for local development (`cp .env.example .env`). DEBUG defaults
# to False, so without a .env the app expects production settings (a real
# SECRET_KEY and ALLOWED_HOSTS). Routing works key-free via the public OSRM server.

# Routing provider: "ors" | "osrm" | "" (auto: uses ORS when ORS_API_KEY is set, else OSRM)
ROUTING_PROVIDER=

# Free OpenRouteService key (https://openrouteservice.org/dev/#/signup). Optional.
# When set (and ROUTING_PROVIDER is "" or "ors"), the robust ORS provider is used.
ORS_API_KEY=
# Provider endpoints (override to self-host OSRM or point at a proxy).
ORS_BASE_URL=https://api.openrouteservice.org
OSRM_BASE_URL=https://router.project-osrm.org
# Per-call HTTP timeout for provider requests, in seconds.
ROUTING_TIMEOUT_SECONDS=8
# Minimum Pelias confidence (0..1) to accept a fuzzy place-name match from ORS
# when the offline city list has no exact entry.
ORS_GEOCODE_MIN_CONFIDENCE=0.5

# Vehicle / algorithm tunables (defaults match the assignment).
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
CORRIDOR_BUFFER_MILES=7

# SQLite file (in a container, point this at a mounted volume).
DATABASE_PATH=db.sqlite3
# Data files (defaults point at the vendored copies under data/).
FUEL_CSV_PATH=data/fuel-prices-for-be-assessment.csv
US_CITIES_CSV_PATH=data/uscities.csv
US_BOUNDARY_GEOJSON_PATH=data/us_boundary_ne10m.geojson

# Django. DEBUG=True is for local development only (browsable API, tracebacks);
# unset or False in production activates the boot guards + transport hardening.
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-me-in-production
# Comma-separated; REQUIRED when DEBUG=False.
ALLOWED_HOSTS=
# Production transport security (read only when DEBUG=False).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False
# Trust X-Forwarded-Proto from a TLS-terminating proxy; False if exposed directly.
TRUST_X_FORWARDED_PROTO=True

# Shared cache + throttle store for multi-process deployments. When set, route
# geometry, plan responses, and rate-limit counters are shared across workers
# (so the "one routing call per route" budget holds globally). Leave blank to
# use the per-process in-memory cache (fine for single-process dev).
REDIS_URL=

# Per-IP request rate limit, shared by the JSON endpoint and the map page (both
# trigger a routing call on a cache miss).
ANON_THROTTLE_RATE=30/min
# Trusted reverse-proxy hops in front of the app. 0 = throttle by the socket
# address and ignore X-Forwarded-For (any client can forge that header). Behind
# one load balancer that appends the client IP, set 1.
NUM_PROXIES=0

# Seconds to remember a routing-provider failure for a given trip before asking
# the provider again (0 = always retry). Unroutable trips are cached like results.
ROUTING_FAILURE_CACHE_SECONDS=30

# Wall-clock budget for ALL upstream work in one request (geocode fallbacks, the
# routing call, its retry, the fallback provider). Keep it below the web server's
# worker timeout (gunicorn defaults to 30 s).
ROUTING_TOTAL_DEADLINE_SECONDS=20
# After a provider FAILURE (outage, quota, unusable response) try the other
# provider once when it is usable: ORS -> OSRM always, OSRM -> ORS if a key is set.
ROUTING_FALLBACK=True

# Log verbosity for the app loggers (routing / trips / stations).
LOG_LEVEL=INFO
